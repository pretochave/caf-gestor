{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cafegestor",
  "main": "worker.cloudflare.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cafegestor-db",
      "database_id": "74f4882c-6494-412b-86e8-0a08fe73fafd",
      "migrations_dir": ".cloudflare-runtime/migrations",
      "migrations_table": "cafegestor_migrations"
    }
  ],
  "account_id": "c23b2880db1dcfea9abc977d66106d2d"
}
