# Configure os valores reais somente nos Secrets da Cloudflare.
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
SITE_URL=
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
# Alternativa legada BetterAuth/Resend, não usada com AUTH_PROVIDER=firebase:
RESEND_API_KEY=
EMAIL_FROM=
# Pagamentos opcionais, independentes da autenticação:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Usados somente pelo provisionamento/CI, sem colocar o token no código:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
